# Auto-detect text files and normalize line endings to LF on commit.
# This prevents CRLF/LF mismatches when jumping between Windows and Linux.
* text=auto eol=lf

# Explicitly declare text file types
*.py        text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.env       text eol=lf

# Binary files — don't touch
*.png       binary
*.jpg       binary
*.xlsx      binary
*.xls       binary
*.pdf       binary
*.zip       binary
