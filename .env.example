# Research Podcast Pipeline — Environment Variables
# Copy this to .env and fill in your API key:
#   cp .env.example .env

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Override output directory
# OUTPUT_DIR=./output/briefings

# Optional: Override config file path
# CONFIG_PATH=./config/default_config.yaml
