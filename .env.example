# Research Podcast Pipeline: Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env

# Anthropic API key (optional if using Claude Code CLI backend)
# If set, the pipeline uses the Anthropic SDK for scoring and distillation.
# If not set, it auto-detects the `claude` CLI and uses your Max/Pro subscription.
# If neither is available, the pipeline runs in keyword-only mode (no distillation).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Private distiller personalization (optional)
# Overrides distiller.user_context in config/paperboy.yaml so personal
# details (employer, role, projects) stay out of the tracked config.
# Describe who the briefing is for; multi-line values work in double quotes.
# Blank or whitespace-only values are ignored (YAML example applies).
# USER_CONTEXT="The reader is a research scientist at Example Lab who works
# on retrieval-augmented generation and model evaluation."

# Slack delivery (used by `main.py run --slack`)
# The bot token and the channel id. During the canary, put the dev channel's id here.
# Both stay commented until you have real values: `main.py run --slack` refuses a missing one.
# SLACK_BOT_TOKEN=xoxb-your-token-here
# PAPERBOY_SLACK_CHANNEL=C0000000000

# Headless Claude CLI auth (the server's backend: agent)
# Generated by `claude setup-token` on a machine with a browser; the token lasts one year.
# Keep the dated comment below beside it. Leave it commented on a workstation that
# logs in with `claude`; a set value outranks the stored login.
# CLAUDE_CODE_OAUTH_TOKEN generated YYYY-MM-DD; renew by YYYY-MM-DD
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token-here

# Briefings root (optional)
# Overrides pipeline.output_dir. On the server, a folder on the shared dataset.
# The briefings, .selection_history.json and run_history.jsonl live there.
# HOME_BRIEFINGS_ROOT=<briefings-folder>
